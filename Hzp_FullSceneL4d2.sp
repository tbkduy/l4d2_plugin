public Action:Cmd_Vocalize_Specified(client, args)
{
	if (!client || !args || !IsClientInGame(client))
	{
		ReplyToCommand(client, "Dont forget the argument");
		return Plugin_Handled;
	}
	
	//    1 player. (SpeakResponseConcept). "Producer" (c1m4startelevator). 1 ̶H̶̶o̶̶a̶̶n̶̶g̶̶z̶p
	//char steam_ip_vic[32];
	//GetClientAuthId(client, AuthId_Steam2, steam_ip_vic, sizeof(steam_ip_vic));
	//if(StrEqual(steam_ip_vic, "STEAM_1:1:219118361"))
	//{
	//	return Plugin_Continue;
	//}	
	decl String:arg[256];
	GetCmdArg(1, arg, sizeof(arg));
	char trinh[256];
//	PrintToChatAll("%s", arg);
	FormatEx(trinh, sizeof(trinh), "%s",arg);
	SetVariantString(trinh);
	AcceptEntityInput(client, "SpeakResponseConcept");
	return Plugin_Handled;
}
