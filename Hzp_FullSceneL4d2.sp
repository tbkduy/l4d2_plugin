public void OnEntityCreated(int entity)
{
	char Nameentity[32];
	GetEntityClassname(entity, Nameentity, sizeof(Nameentity));
//	PrintToChatAll("%s",Nameentity);
	if(StrEqual(Nameentity, "instanced_scripted_scene", false))
	{
		SDKHook(entity, SDKHook_SpawnPost , ChangModel);

		
	if(!IsValidEdict(entity)){
		return;
	}
	int client = GetEntPropEnt(entity, Prop_Data, "m_hOwner");
	if(!IsValidEdict(client) || client == 0){
		return;
	}	
	char model[256];
	GetEntPropString(client, Prop_Data, "m_ModelName", model, sizeof(model));
	if (StrContains(model, "gambler") != -1)
	{
		SetVariantString("who:Gambler:0");
		DispatchKeyValue(client, "targetname", "Gambler");
		AcceptEntityInput(client, "AddContext");		
	}
	else if (StrContains(model, "coach") != -1)
	{
		SetVariantString("who:Coach:0");
		DispatchKeyValue(client, "targetname", "Coach");
		AcceptEntityInput(client, "AddContext");
	}
	else if (StrContains(model, "mechanic") != -1)
	{
		SetVariantString("who:Mechanic:0");
		DispatchKeyValue(client, "targetname", "Mechanic");
		AcceptEntityInput(client, "AddContext");
	}
	else if (StrContains(model, "producer") != -1)
	{
		SetVariantString("who:Producer:0");
		DispatchKeyValue(client, "targetname", "Producer");
		AcceptEntityInput(client, "AddContext");
	}
	else if (StrContains(model, "biker") != -1)
	{
		SetVariantString("who:Biker:0");
		DispatchKeyValue(client, "targetname", "Biker");
		AcceptEntityInput(client, "AddContext");
	}
	else if (StrContains(model, "manager") != -1)
	{
		SetVariantString("who:Manager:0");
		DispatchKeyValue(client, "targetname", "Manager");
		AcceptEntityInput(client, "AddContext");
	}
	else if (StrContains(model, "namvet") != -1)
	{
		SetVariantString("who:NamVet:0");
		DispatchKeyValue(client, "targetname", "NamVet");
		AcceptEntityInput(client, "AddContext");
	}
	else if (StrContains(model, "teenangst") != -1)
	{
		SetVariantString("who:TeenGirl:0");
		DispatchKeyValue(client, "targetname", "teengirl");
		AcceptEntityInput(client, "AddContext");
	}
	}
}
public Action ChangModel(int entity)
