public Action Runtest(Handle timer, any coward)
{
	char file[PLATFORM_MAX_PATH];
	bool play = true;
	for(int i = 1; i <= GetEntityCount(); i++)
	{

		if(IsValidEdict(i))
		{
		//	PrintToChatAll("18055:%i", i);
			GetEdictClassname(i, file, sizeof(file));
			if(StrEqual(file, "instanced_scripted_scene")){//ambient_music  ambient_generic
				GetEntPropString(i, Prop_Data, "m_iszSceneFile", file, PLATFORM_MAX_PATH);
				if(StrEqual(file, "scenes/teengirl/dlc1_c6m1_initialmeeting13.vcd")){
				PrintToChatAll("Found:%s", file);
				play = false;
				}
			}	
		}
	}
	if(play){
	Hzp_Callvoicalize("scenes/teengirl/dlc1_c6m1_initialmeeting13.vcd",0);	 //scenes/teengirl/dlc1_c6m1_initialmeeting13.vcd
	}
}
